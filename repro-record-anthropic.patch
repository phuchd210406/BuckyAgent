From 9f485a49b65f23f06868a1859c37ce5dc5f40be2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 14:46:40 +0800
Subject: [PATCH] fix(record): record cassettes from the Anthropic API, not
 only Bedrock

`make record` hard-wired BedrockLLM, so a machine with only an Anthropic
API key failed every case with NoCredentialsError. It then overwrote
eval/recorded_runs.json with nine failures, which breaks the replay test.

- `make record PROVIDER=anthropic` (or --provider) records through
  AnthropicLLM, with the same per-run and session budget guards.
- The manifest is left alone when every case failed.
- The manifest now records which provider made it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KGsvdpLJ4ZoDJvjm8iGWHZ
---
 Makefile                    |  5 +++--
 docs/DEPLOY.md              |  2 +-
 scripts/record_cassettes.py | 42 +++++++++++++++++++++++++++++++------
 3 files changed, 40 insertions(+), 9 deletions(-)

diff --git a/Makefile b/Makefile
index 01ee057..8bc0bcb 100644
--- a/Makefile
+++ b/Makefile
@@ -48,8 +48,9 @@ ifndef REPO
 endif
 	$(PY) -m repro.cli run --repo-url "$(REPO)" --report "$(REPORT)" -v
 
-record:                   ## Re-record cassettes against real Bedrock (COSTS MONEY)
-	REPRO_RECORD=1 LLM_PROVIDER=bedrock $(PY) scripts/record_cassettes.py
+PROVIDER ?= bedrock
+record:                   ## Re-record cassettes (COSTS MONEY). PROVIDER=anthropic for an API key
+	REPRO_RECORD=1 LLM_PROVIDER=$(PROVIDER) $(PY) scripts/record_cassettes.py --provider $(PROVIDER)
 
 eval:                     ## Score the golden dataset by RUNNING the agent (free, replayed)
 	LLM_PROVIDER=fake $(PY) eval/run_eval.py --dataset eval/dataset.yaml
diff --git a/docs/DEPLOY.md b/docs/DEPLOY.md
index 16cb743..d91d7f5 100644
--- a/docs/DEPLOY.md
+++ b/docs/DEPLOY.md
@@ -84,7 +84,7 @@ Only Engineer C, and only while recording cassettes, should have `REPRO_RECORD=1
