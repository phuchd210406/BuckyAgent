# Copy to .env — NEVER commit .env (see .gitignore)

# ---------------------------------------------------------------------------
# Which model answers
# ---------------------------------------------------------------------------
# auto     = the first provider below that has a credential. What the app ships
#            with: a missing key degrades to `fake` with an explanation on the
#            page instead of a stack trace.
# anthropic= Claude Haiku 4.5 on the first-party API. Needs ANTHROPIC_API_KEY.
#            Preferred for a real run: the key does not expire at lunchtime.
# bedrock  = the same model through the AWS sandbox lease. What the AgentCore
#            deployment uses. Credentials expire every 12h.
# fake     = replay recorded cassettes. Free, offline, deterministic, and NOT a
#            real run: it can only answer prompts somebody already recorded, so
#            it works for the seeded demo repo and misses on anything else.
LLM_PROVIDER=auto

# --- provider 1: the Anthropic API ----------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
REPRO_ANTHROPIC_MODEL_ID=claude-haiku-4-5

# --- provider 2: Bedrock ---------------------------------------------------
# SETTLED EMPIRICALLY (make check-bedrock, 2026-09-06): us-east-1, using the
# `us.` inference profile id below. ap-southeast-1 publishes only the `global.`
# profile, which our SSO permission set is not allowed to invoke. Re-run
# `make check-bedrock` if AWS ever says AccessDenied again — it prints the exact
# id and region that answer.
AWS_DEFAULT_REGION=us-east-1
REPRO_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Temporary sandbox creds expire every 12h — re-paste from the AWS access portal.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Which repository it can investigate
# ---------------------------------------------------------------------------
# Public GitHub repos need nothing. A PRIVATE one needs a token that can read
# it; it is used for the clone and then wiped from the checkout's git config.
GITHUB_TOKEN=

# Where clones are cached between runs. Safe to delete at any time.
# REPRO_CLONE_CACHE=~/.cache/repro/repos
# REPRO_MAX_REPO_MB=500
# REPRO_CLONE_TIMEOUT_S=180

# Local directories a `repo_path` may point at, comma separated. The clone cache
# is always allowed on top of these. Empty disables the check entirely — do not
# do that on a machine anyone else can reach.
# REPRO_ALLOWED_REPOS=fixtures/demo_repos

# ---------------------------------------------------------------------------
# The sandbox
# ---------------------------------------------------------------------------
REPRO_WORKSPACE=/tmp/repro-workspaces
REPRO_RECORD=0

# auto (default) installs a real project's declared dependencies into a
# throwaway virtualenv per run, because otherwise its tests fail at import and
# every run ends "not reproduced" for the wrong reason. 0 turns that off.
# REPRO_INSTALL_DEPS=auto
# REPRO_INSTALL_TIMEOUT_S=420

# One pytest invocation's ceiling. 60s suits the seeded fixture; a real
# project's whole suite usually needs more, and a suite that times out looks
# exactly like a patch that broke it.
REPRO_SANDBOX_TIMEOUT_S=180

# Process-wide spend cap across all runs. Per-run is MAX_RUN_USD in contracts.py.
# REPRO_SESSION_BUDGET_USD=1.00
