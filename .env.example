# Copy to .env — NEVER commit .env (see .gitignore)

# fake = replay cassettes, zero cost, deterministic. Use this by default.
# bedrock = real calls, costs money against the team's USD 20.
LLM_PROVIDER=fake

# Session 1 says model access was granted for Claude Haiku 4.5 in ap-southeast-1;
# the AWS setup deck's troubleshooting slide says us-east-1. VERIFY with
# `make check-bedrock` before anyone writes agent code against it.
AWS_DEFAULT_REGION=us-east-1
REPRO_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Temporary sandbox creds expire every 12h — re-paste from the AWS access portal.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

REPRO_WORKSPACE=/tmp/repro-workspaces
REPRO_RECORD=0
