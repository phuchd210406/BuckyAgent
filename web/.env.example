# Where the deployed frontend sends its requests. Baked in AT BUILD TIME, so it
# must be set in Vercel's project settings BEFORE the build, and a change needs
# a redeploy -- not just a page refresh.
#
# Leave it unset locally: `npm run dev` proxies /runs to :8000 through Vite, and
# same-origin needs no CORS at all.
#
# Deployed, point it at whatever is fronting the backend, with no trailing slash:
VITE_API_BASE=https://your-tunnel.ngrok-free.app
